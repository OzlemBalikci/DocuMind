# PostgreSQL (docker-compose host port → container 5432)
POSTGRES_DB=interviewpilot_db
POSTGRES_USER=interviewpilot_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5435

# JWT (create: openssl rand -base64 48)
JWT_SECRET=change-me-openssl-rand-base64-48-create-with

# Groq — use mock if key does not exist
GROQ_API_KEY=
LLM_PROVIDER=mock
LLM_MODEL=llama-3.3-70b-versatile
LLM_DAILY_LIMIT=15
LLM_GLOBAL_DAILY_LIMIT=300

# Backend (Spring local profili application-local.properties ile okur)
PORT=8087
SPRING_PROFILES_ACTIVE=local
APP_CORS_ALLOWED_ORIGINS=

# Not: .env dosyasini kopyala → .env
# IntelliJ: Run Configuration → Environment variables → "Load from file" (.env)