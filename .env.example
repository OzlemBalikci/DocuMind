POSTGRES_DB=documind_db
POSTGRES_USER=documind_app
POSTGRES_PASSWORD=CHANGE_ME
local.postgres.username=documind_app
local.postgres.password=CHANGE_ME

spring.datasource.password=CHANGE_ME
POSTGRES_PORT=5435

# Redis (docker-compose: 6379) — gateway rate limit
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ (docker-compose: 5672 AMQP, 15672 management UI)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=documind
RABBITMQ_PASSWORD=CHANGE_ME
local.rabbitmq.password=CHANGE_ME
RABBITMQ_VHOST=/

OLLAMA_BASE_URL=http://localhost:11434

LLM_PROVIDER=mock
LLM_MODEL=llama3.2:3b
LLM_DAILY_LIMIT=50
LLM_GLOBAL_DAILY_LIMIT=500
LLM_TIMEOUT_SECONDS=120

# Keycloak (identity, passwords, tokens, mail, reset, brute force)
KEYCLOAK_ISSUER=http://localhost:8180/realms/documind
KEYCLOAK_AUDIENCE=documind-api
KC_DB_PASSWORD=CHANGE_ME
KC_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_USER_SERVICE_CLIENT_ID=user-service-admin
# Must match the confidential client secret imported with realm-documind.json (local only).
# Production: set the secret in Keycloak and inject it from a secret manager — do not commit it.
KEYCLOAK_USER_SERVICE_CLIENT_SECRET=local-dev-user-service-admin-secret
KEYCLOAK_USER_SERVICE_INTERNAL_CLIENT_ID=user-service-internal
KEYCLOAK_USER_SERVICE_INTERNAL_SECRET=local-dev-user-service-internal-secret

# Keycloak SMTP is configured in the admin console (Realm settings → Email), not in this repo.

# Object storage for document-service
MINIO_ACCESS_KEY=documind
MINIO_SECRET_KEY=documind-secret
MINIO_PORT=9000

PORT=8087
SPRING_PROFILES_ACTIVE=local
APP_CORS_ALLOWED_ORIGINS=http://localhost:5199

# Kullanim: bu dosyayi kopyala → .env, CHANGE_ME alanlarini doldur (.env commit edilmez)
# Keycloak: docker compose up keycloak  →  http://localhost:8180  (admin / KC_ADMIN_PASSWORD)
# Issuer sabit kalmali: http://localhost:8180/realms/documind
# SPA: keycloak-js url=http://localhost:8180 realm=documind clientId=documind-web PKCE S256
