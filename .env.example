JWT_SECRET=change-me-openssl-rand-base64-48-create-with
local.jwt.secret=change-me-openssl-rand-base64-48-create-with


# RabbitMQ (docker-compose: 5672 AMQP, 15672 management UI)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=interviewpilot
RABBITMQ_PASSWORD=CHANGE_ME
local.rabbitmq.password=CHANGE_ME
RABBITMQ_VHOST=/


OLLAMA_BASE_URL=http://localhost:11434


LLM_PROVIDER=mock
LLM_MODEL=llama3.2:3b
LLM_DAILY_LIMIT=50
LLM_GLOBAL_DAILY_LIMIT=500
LLM_TIMEOUT_SECONDS=120


PORT=8087
SPRING_PROFILES_ACTIVE=local
