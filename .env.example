POSTGRES_DB=documind_db
POSTGRES_USER=documind_app
POSTGRES_PASSWORD=CHANGE_ME
local.postgres.username=documind_app
local.postgres.password=CHANGE_ME

spring.datasource.password=CHANGE_ME
POSTGRES_PORT=5435

JWT_SECRET=change-me-openssl-rand-base64-48-create-with
local.jwt.secret=change-me-openssl-rand-base64-48-create-with

# Redis (docker-compose: 6379)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ (docker-compose: 5672 AMQP, 15672 management UI)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=documind
RABBITMQ_PASSWORD=CHANGE_ME
local.rabbitmq.password=CHANGE_ME
RABBITMQ_VHOST=/


OLLAMA_BASE_URL=http://localhost:11434


LLM_PROVIDER=mock
LLM_MODEL=llama3.2:3b
LLM_DAILY_LIMIT=50
LLM_GLOBAL_DAILY_LIMIT=500
LLM_TIMEOUT_SECONDS=120


PORT=8087
SPRING_PROFILES_ACTIVE=local
APP_CORS_ALLOWED_ORIGINS=http://localhost:5199


# Kullanim: bu dosyayi kopyala → .env, CHANGE_ME alanlarini doldur (.env commit edilmez)
# Calistirma: .\scripts\run-local.ps1  (ozel karakterli sifreler icin mvnw spring-boot:run yerine)
# IntelliJ: Run Configuration → Environment variables → Load from file (.env)
