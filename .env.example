# PostgreSQL (docker-compose host port → container 5432)
POSTGRES_DB=interviewpilot_db
POSTGRES_USER=interviewpilot_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5435

# JWT (PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 })))
JWT_SECRET=change-me-openssl-rand-base64-48-create-with

# RabbitMQ (docker-compose: 5672 AMQP, 15672 management UI)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=interviewpilot
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=/

# Ollama (Docker compose veya native — ikisi de 11434)
OLLAMA_BASE_URL=http://localhost:11434

# LLM: mock (1. gün / CI) | ollama (gerçek model, 2. gün)
LLM_PROVIDER=mock
LLM_MODEL=llama3.2:3b
LLM_DAILY_LIMIT=50
LLM_GLOBAL_DAILY_LIMIT=500
LLM_TIMEOUT_SECONDS=120

# Backend (application-local.properties bu degiskenleri okur)
PORT=8087
SPRING_PROFILES_ACTIVE=local
APP_CORS_ALLOWED_ORIGINS=http://localhost:5199

# Frontend icin ayri: frontend/.env.local → VITE_API_URL=http://localhost:8087

# Kullanim: bu dosyayi kopyala → .env, CHANGE_ME alanlarini doldur (.env commit edilmez)
# IntelliJ: Run Configuration → Environment variables → Load from file (.env)
